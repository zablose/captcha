{
    "name": "zablose/captcha",
    "description": "Simple captcha with optional goodies for Laravel.",
    "keywords": [
        "captcha",
        "security",
        "php",
        "laravel",
        "spam",
        "bot"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sergejs Zablockis",
            "email": "zablose@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-gd": "*"
    },
    "require-dev": {
        "ext-pdo": "*",
        "fakerphp/faker": "^1.24.1",
        "laravel/framework": "^12.20.0",
        "laravel/tinker": "^2.10.1",
        "laravel/ui": "^4.6.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.2",
        "phpunit/phpunit": "^11.5.27",
        "phing/phing": "^3.0.1"
    },
    "autoload": {
        "psr-4": {
            "Zablose\\Captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zablose\\Captcha\\Tests\\Laravel\\App\\": "laravel/app/",
            "Zablose\\Captcha\\Tests\\Laravel\\Database\\Factories\\": "laravel/database/factories/",
            "Zablose\\Captcha\\Tests\\Laravel\\Tests\\": "laravel/tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "Zablose\\Captcha\\CaptchaServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
